# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# --- Security ---------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret

# Code required to create an admin (teacher) account. Share it only with staff.
# Leave blank to disable admin registration entirely.
ADMIN_SIGNUP_CODE=

# --- Optional ---------------------------------------------------------------
OPENAI_MODEL=gpt-4.1

# Lifts the GitHub API rate limit from 60/hr (anonymous) to 5000/hr.
# A classic token with NO scopes is enough for public repos.
GITHUB_TOKEN=

# SQLite locally; swap for postgresql+psycopg://user:pass@host/db in production.
DATABASE_URL=sqlite:///./assignment_tracker.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Analysis guard rails
MAX_REPO_SIZE_KB=50000
MAX_FILES=2000
